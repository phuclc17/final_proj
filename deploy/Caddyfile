# Reverse proxy + HTTPS tu dong. DOMAIN lay tu bien moi truong (deploy/.env), vi du 203-0-113-5.sslip.io:
# ten mien dang <IP>.sslip.io tu tro ve dung IP may chu, khong can mua ten mien.
{$DOMAIN} {
	encode gzip
	reverse_proxy app:8501
}

bi.{$DOMAIN} {
	encode gzip
	reverse_proxy metabase:3000
}

airflow.{$DOMAIN} {
	encode gzip
	reverse_proxy airflow:8080
}
