# Sao chep thanh deploy/.env tren may chu va dien gia tri. Tep .env khong dua vao git.
# DOMAIN: dia chi IP cong khai cua may chu, thay dau cham bang gach ngang, them .sslip.io
#   vi du IP 203.0.113.5 -> DOMAIN=203-0-113-5.sslip.io
DOMAIN=

# Mat khau quan tri (chi chu so huu biet) va tai khoan chi xem Airflow cho giang vien (ghi trong bao cao)
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_VIEWER_PASSWORD=

# Kho phuc vu PostgreSQL va Metabase
PG_ADMIN_USER=fastfat
PG_ADMIN_PASSWORD=
BI_READER_PASSWORD=
MB_DB_PASSWORD=
METABASE_ADMIN_EMAIL=admin@fastfat.local
METABASE_ADMIN_PASSWORD=

# Token cua API nguon gia lap (chi dung trong mang noi bo)
SOURCE_API_TOKEN=
