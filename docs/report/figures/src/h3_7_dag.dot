digraph G {
  rankdir=TB; nodesep=0.4; ranksep=0.3; fontname="Arial"; newrank=true;
  node [fontname="Arial", fontsize=13];
  edge [color="#3B6FB6", penwidth=1.6, fontname="Arial"];

  subgraph cluster_src { label="DAG fastfat_nguon · hệ thống nguồn · 23:00 hằng ngày"; fontsize=14; labeljust=l;
    style="rounded"; color="#9AA5B1"; bgcolor="#F7F8FA";
    node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#7B8794", penwidth=1.4, margin="0.16,0.08", width=2.9];
    wait [label="chờ pipeline rảnh\n(không ghi ngày mới khi lô trước đang xử lý)"];
    exp  [label="ghi ngày kinh doanh mới\n(trong khóa luận: bộ mô phỏng)"];
    wait -> exp [color="#7B8794"];
  }
  ds [shape=folder, style=filled, fillcolor="#FFF8E1", color="#D4A500", fontsize=12.5, margin="0.12,0.06",
      label="Dataset: dữ liệu nguồn\nđược cập nhật"];
  exp -> ds [color="#D4A500", label="  báo cập nhật", fontsize=11.5, fontcolor="#7A6200"];

  subgraph cluster_af { label="DAG fastfat_pipeline · chạy khi Dataset cập nhật, kiểm tra thêm mỗi giờ"; fontsize=14; labeljust=l; labelloc=b;
    style="rounded"; color="#3B6FB6"; bgcolor="#F7FAFE";
    node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#3B6FB6", penwidth=1.6, margin="0.16,0.08", width=2.9];
    ext [label="1. extract\nkéo dữ liệu mới qua API của\nPOS đám mây và App, theo mốc ngày"];
    chk [label="2. check\ncó tệp nguồn chưa nạp không?"];
    ing [label="3. ingest\nnạp Bronze tăng dần theo mã băm tệp,\nkiểm tra hợp đồng dữ liệu"];
    qg  [label="4. quality\ncửa chặn đầu vào: độ mới, khối lượng,\nđầy đủ, tệp bị từ chối, cấu trúc"];
    dbt [label="5. dbt build\nSilver, Gold và kiểm thử dữ liệu"];
    det [label="6. detect\nquét bộ chỉ số giám sát,\nchấm điểm nguyên nhân"];
    pub [label="7. publish\nđưa Gold, ops sang PostgreSQL,\nđối soát số dòng"];
    ext -> chk -> ing -> qg -> dbt -> det -> pub;
  }
  ds -> ext [color="#D4A500"];
  node [shape=cylinder, style=filled, fillcolor="#F4F6F8", color="#9AA5B1", fontsize=12, margin="0.08,0.04", width=2.1];
  edge [color="#9AA5B1", penwidth=1, style=dashed, arrowsize=0.6];
  o0 [label="source_systems/: tệp JSON, CSV,\nExcel; kho của POS đám mây, App"];
  o1 [label="source_systems/pos, owned_app\nlanding/api_connector.json"];
  o2 [label="bronze.*\nbronze._ingest_log"];
  o3 [label="ops.dq_checks\nops.schema_registry"]; o4 [label="silver.*, gold.*\n211 bước, kiểm thử"];
  o5 [label="ops.alerts\nops.alert_scores"]; o6 [label="PostgreSQL: gold, ops\n→ Metabase"];
  exp -> o0; ext -> o1; ing -> o2; qg -> o3; dbt -> o4; det -> o5; pub -> o6;
  { rank=same; exp; o0; } { rank=same; ext; o1; } { rank=same; ing; o2; } { rank=same; qg; o3; } { rank=same; dbt; o4; }
  { rank=same; det; o5; } { rank=same; pub; o6; }
  note [shape=note, style=filled, fillcolor="#FFFFFF", color="#9AA5B1", fontsize=12, width=0,
        label="API không phản hồi: extract ghi cảnh báo, các nguồn tệp vẫn chạy tiếp.\nKhông có tệp mới: check thoát mã 99, các bước sau được bỏ qua.\nMỗi bước ghi 1 dòng vào ops.pipeline_runs.\nMục ở mức chặn hoặc kiểm thử dbt lỗi: bước sau không chạy,\ndữ liệu lỗi không lan lên Silver, Gold và kho phục vụ."];
  pub -> note [style=invis];
}
