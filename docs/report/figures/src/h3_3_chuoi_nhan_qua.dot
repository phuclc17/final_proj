digraph G {
  rankdir=TB; nodesep=0.22; ranksep=0.42; fontname="Arial"; newrank=true;
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, color="#9AA5B1", fillcolor="#F4F6F8", margin="0.12,0.07"];
  edge [color="#7A869A", penwidth=1.4, fontname="Arial", fontsize=11, fontcolor="#52606D"];

  subgraph cluster_day { label="Trong cùng ngày, theo từng giờ"; fontsize=14; style="rounded,dashed"; color="#C5CDD5"; labeljust=l;
    staff [label="Nhân sự đi làm theo ca\n(số nhân viên bếp mỗi giờ)", fillcolor="#FBE3E6", color="#C8102E", penwidth=1.6];
    load  [label="Tải bếp mỗi giờ\nρ = số đơn / năng lực bếp"];
    prep  [label="Thời gian chuẩn bị\n4 + 6 / (1 − ρ)^0,6 phút"];
    balk  [label="Khách tại\nquầy bỏ về"];
    scan  [label="Cửa hàng\ntự hủy đơn"];
    ccan  [label="Khách hủy\nvì chờ lâu"];
    rate  [label="Điểm đánh giá\ntừng đơn giảm"];
    now   [label="Doanh thu tại quầy, App giảm ngay", fillcolor="#FDF1C7", color="#D4A500", penwidth=1.6];
  }
  subgraph cluster_week { label="Các tuần sau"; fontsize=14; style="rounded,dashed"; color="#C5CDD5"; labeljust=l;
    wrate [label="Điểm đánh giá tuần\n(trung bình trượt)"];
    rank  [label="Hệ số thứ hạng trên sàn\nX = 1 + 0,8 (R − 4,5)\nsố đơn sàn tuần sau giảm"];
    later [label="Doanh thu sàn giảm\nsau 1–3 tuần", fillcolor="#FDF1C7", color="#D4A500", penwidth=1.6];
  }
  staff -> load [label=" ít người"]; load -> prep [label=" quá tải"];
  prep -> balk; prep -> scan; prep -> ccan; prep -> rate;
  balk -> now; scan -> now; ccan -> now;
  rate -> wrate;
  wrate -> rank -> later;
  { rank=same; balk; scan; ccan; rate; wrate; }
  { rank=same; now; rank; }
}
