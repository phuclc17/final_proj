digraph G {
  rankdir=LR; splines=ortho; nodesep=0.16; ranksep=0.55; fontname="Times-Roman"; bgcolor="white";
  node [shape=box, fontname="Times-Roman", fontsize=15, color="black", penwidth=1, margin="0.12,0.06"];
  edge [color="black", penwidth=1, arrowhead=none];

  root [label="Lợi nhuận gộp\nvận hành"];
  rev  [label="(+) Doanh thu thuần\n= tổng bốn kênh"];
  cogs [label=<(−) Giá vốn<BR/><I>P2 hao hụt hàng tươi</I><BR/><I>P4 thất thoát hàng giá trị cao</I>>];
  lab  [label=<(−) Chi phí nhân công<BR/><I>giờ công × lương giờ</I>>];
  fee  [label=<(−) Phí hoa hồng sàn<BR/><I>P1a tỷ lệ sai hợp đồng</I>>];
  walk [label=<Tại quầy = số đơn × AOV<BR/><I>P3 khách bỏ về; P5 hủy, hoàn</I>>];
  app  [label=<App riêng = số đơn × AOV<BR/><I>P3 chuẩn bị lâu, tự hủy đơn</I>>];
  grab [label=<GrabFood = số đơn × AOV<BR/><I>P1b đơn không vào POS; P3 tụt hạng</I>>];
  shop [label=<ShopeeFood = số đơn × AOV<BR/><I>P1b đơn không vào POS; P3 tụt hạng</I>>];

  root -> rev; root -> cogs; root -> lab; root -> fee;
  rev -> walk; rev -> app; rev -> grab; rev -> shop;
}
